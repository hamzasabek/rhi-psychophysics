# --- PlatformIO build artefacts -------------------------------------------
# Everything here is regenerated by the compiler. Committing it would make
# every diff unreadable and would conflict between machines.
firmware/.pio/
firmware/.pioenvs/
firmware/.piolibdeps/
firmware/.clang_complete
firmware/.gcc-flags.json

# --- Python ----------------------------------------------------------------
host/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Data -------------------------------------------------------------------
# Raw participant data does not go in git: it is large, it changes constantly,
# and it may be personal data. Keep the folders, not the contents.
data/raw/*
data/calibration/*
!data/raw/.gitkeep
!data/calibration/.gitkeep

# --- Editor / OS ------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
