{
  "folders": [
    { "path": "firmware", "name": "Firmware (C++)" },
    { "path": "host",     "name": "Host (Python)" },
    { "path": ".",        "name": "Project root" }
  ],
  "settings": {
    "python.defaultInterpreterPath": "host/.venv/Scripts/python.exe",
